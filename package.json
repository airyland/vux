{
  "name": "vux",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --mode mobile",
    "add": "node ./cli/quickCreateComponent.js",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:full": "npm run build:lib && npm run build:theme",
    "build:theme": "node ./build/genStyle.js",
    "preview": "vite preview",
    "test": "vitest",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.24",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/compiler-sfc": "^3.4.21",
    "autoprefixer": "^10.4.27",
    "chalk": "^5.3.0",
    "fast-glob": "^3.3.2",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "less": "^4.2.0",
    "postcss": "^8.5.8",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-vue": "^6.0.0",
    "sass": "^1.99.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.3.3",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.1.4",
    "vite-plugin-dts": "^3.7.3",
    "vite-plugin-md": "^0.21.5",
    "vite-plugin-vuedoc": "^3.1.3",
    "vitest": "^1.3.1",
    "vue-tsc": "^2.0.6"
  },
  "files": [
    "lib",
    "es",
    "packages",
    "vetur",
    "theme-chalk"
  ],
  "keywords": [
    "ui",
    "vue",
    "vue3",
    "frontend",
    "component",
    "components"
  ],
  "main": "dist/vux.umd.js",
  "module": "dist/vux.esm.js",
  "types": "dist/vux.d.ts",
  "unpkg": "dist/vux.umd.js",
  "style": "packages/theme-chalk/weui.less",
  "vetur": {
    "tags": "./vetur/tags.json",
    "attributes": "./vetur/attributes.json"
  },
  "web-types": "./vetur/web-types.json",
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
